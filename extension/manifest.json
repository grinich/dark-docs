{
  "manifest_version": 3,
  "name": "Dark Docs",
  "version": "1.2.0",
  "description": "A quiet charcoal theme for Google Docs. Follows your computer’s appearance automatically.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Dark Docs",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "exclude_matches": [
        "https://docs.google.com/document/*/pub*"
      ],
      "css": [
        "theme.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://docs.google.com/drivesharing/*"
      ],
      "css": [
        "embedded.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "minimum_chrome_version": "120"
}
